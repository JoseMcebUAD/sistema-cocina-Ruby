# Copia este archivo a .env (no versionar) y rellena los valores reales.
# En producción se configuran como variables de entorno del sistema o del contenedor.

# JWT — generar con: openssl rand -base64 48
JWT_SECRET=

# Base de datos MySQL
DATABASE_URL=jdbc:mysql://localhost:3306/cocina_rubi
DB_USERNAME=root
DB_PASSWORD=

# Cloudinary (rotar el api-secret que quedó expuesto en el historial de git)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Proxies confiables para leer X-Real-IP (coma-separado). En prod: IP interna de nginx.
TRUSTED_PROXIES=127.0.0.1,::1
